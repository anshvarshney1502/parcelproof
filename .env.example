APP_URL=http://localhost:3000

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Needed behind Render's proxy
AUTH_TRUST_HOST=true

MONGODB_URI=
MONGODB_DB_NAME=parcelproof

GEMMA_API_KEY=
GEMMA_MODEL_ID=gemma-4-26b-a4b-it

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: separate voice for Hinglish briefings (falls back to ELEVENLABS_VOICE_ID)
ELEVENLABS_VOICE_ID_HINGLISH=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

MAX_UPLOAD_MB=10
MAX_EVIDENCE_PER_CASE=10
MAX_USER_STORAGE_MB=100

AI_DAILY_LIMIT=8
TTS_DAILY_LIMIT=3
# Voice-note transcriptions and dictations per user per day
STT_DAILY_LIMIT=15
# Max characters of evidence text sent to Gemma per analysis
AI_MAX_INPUT_CHARS=60000
